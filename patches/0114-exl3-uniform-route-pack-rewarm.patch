+def rewarm_uniform_route_packs() -> int:
+    """Re-run the uniform plans' B12X compile jobs after preparation eviction.
+
+    The uniform-K4 (full-rotation) runtime launches its route packs raw
+    (``launches=None``), and every B12X preparation job ends with
+    ``evict_unretained(keep)``. When the capture then JIT-misses a raw
+    route-pack specialization, the frozen session refuses it (the r5 boot
+    11 capture freeze). This is the uniform analogue of the 0111 mixed
+    rewarm: vLLM calls it after the last preparation job and kernel warmup,
+    immediately before capture, so these factory runs are the final writer
+    of the raw JIT cache. Each stored plan retains its own encoded compile
+    job payloads, so B12X's own factories run again with zero reconstructed
+    geometry. The prewarm dedup set must be cleared first, or the re-run
+    skips every launch exactly like the mixed rewarm's dedup set did.
+    """
+    if not _UNIFORM_EXECUTION_PLANS:
+        return 0
+    from b12x._lib import compile_pool as _b12x_compile_pool
+    from b12x.moe.fused_moe import _impl as _b12x_fused_impl
+    from b12x.preparation.device import detect_device
+
+    _b12x_fused_impl._W4A16_ROUTE_PACK_PREWARMED.clear()
+    jobs_run = 0
+    # The factories allocate their own dummy route tensors and launch real
+    # kernels; arena states are inference tensors during serving, and B12X
+    # zeroes scratch in place, which only InferenceMode permits here (the
+    # r5 boot 3 mixed-rewarm crash pattern).
+    with torch.inference_mode():
+        for plan in list(_UNIFORM_EXECUTION_PLANS.values()):
+            # The uniform path stores the planner's own output: a scalar
+            # Plan, or a _CompositePlan family holding one scalar child
+            # per planned token count. Each child carries its own encoded
+            # compile jobs, so the family must be flattened here (the r5
+            # boot 13 AttributeError on _CompositePlan._device).
+            children = (
+                tuple(plan.variants.values())
+                if hasattr(plan, "variants")
+                else (plan,)
+            )
+            for child in children:
+                device = detect_device(
+                    child._device
+                    if child._device is not None
+                    else getattr(child.query, "device", None)
+                )
+                configuration = child.contract.configure(
+                    child.query, device=device.identity, override=child.override
+                )
+                config = (
+                    configuration.default
+                    if configuration.pinned is None
+                    else configuration.pinned
+                )
+                for job in child._compile_jobs(config, device):
+                    factory = _b12x_compile_pool._factory(job.factory)
+                    factory(*job.args, **dict(job.kwargs))
+                    jobs_run += 1
+    logger.info(
+        "%s EXL3 uniform route-pack rewarm (post-eviction): "
+        "plans=%d compile-jobs=%d",
+        _REVISION_TAG,
+        len(_UNIFORM_EXECUTION_PLANS),
+        jobs_run,
+    )
+    return jobs_run
+

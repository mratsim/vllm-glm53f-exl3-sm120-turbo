+    def get_b12x_preparation_units(
+        self,
+        layer: RoutedExperts,
+        workload: Any,
+    ) -> tuple[Any, ...]:
+        """Describe the uniform rank-sliced runtime to the b12x session.
+
+        Called by the driver's weights-stage walk through the provider the
+        layer got in _prepare_rank_sliced_weights. The plan_execution request
+        registered here makes the session prepare (autotune, JIT compile,
+        bind-check) and RETAIN every program the serving bind will use, so
+        the mid-capture evictions that froze the mixed path's raw warmup
+        cannot recur on this path.
+        """
+        from vllm.utils.b12x import (
+            B12xPreparationUnit,
+            PreparationResourceUnavailableError,
+        )
+
+        if workload.stage != "weights":
+            return ()
+        if getattr(layer, "exl3_mixed_bitrate", False):
+            # The mixed path warms through the construction warmup plus the
+            # post-eviction rewarm hook; it owns no session unit here.
+            return ()
+        prepared = getattr(layer, "exl3_trellis_weights", None)
+        if prepared is None:
+            raise PreparationResourceUnavailableError(
+                f"{_REVISION_TAG} EXL3 rank-sliced layer {layer.layer_name!r} "
+                "reached b12x weight preparation without adopted Trellis "
+                "weights"
+            )
+        api = _load_b12x_fused_moe()
+        topk = int(getattr(layer, "top_k", 0) or 8)
+        counts = tuple(int(count) for count in workload.token_counts)
+        existing = getattr(layer, "exl3_execution_plan", None)
+        if (
+            existing is not None
+            and getattr(layer, "exl3_execution_counts", None) == counts
+        ):
+            plan = existing
+        else:
+            # b12x's execution planner gates on the canonical PreparedExperts
+            # wrapper (isinstance in _preparation.plan), not on the raw
+            # B12XFP4ExpertWeights owner our adapter builds. Wrap the adopted
+            # owner: WeightPlan._impl IS the adopted MoEWeightPreparationPlan
+            # so the wrapper's equality check holds, and every content field
+            # the planner reads (quant_modes, source_format, layouts,
+            # geometry, trellis descriptor) comes from that same plan.
+            # source stays None: only canonical prepare_weights reads it and
+            # the adapter bypasses that path (weights arrive TRELLIS-native
+            # via adoption); fabricating scale/transform declarations would
+            # state contracts nothing reads.
+            plan_impl = prepared.plan
+            experts = api.PreparedExperts(
+                plan=api.WeightPlan(
+                    source=None,
+                    activation=api.ActivationSpec(
+                        mode=api.ActivationMode.A16,
+                        nonlinearity=str(plan_impl.activation),
+                        io_dtype=getattr(
+                            torch,
+                            str(plan_impl.io_dtype).removeprefix("torch."),
+                        ),
+                    ),
+                    geometry=api.MoEGeometry(
+                        num_experts=int(plan_impl.num_experts),
+                        hidden_size=int(plan_impl.hidden_size),
+                        intermediate_size=int(plan_impl.intermediate_size),
+                    ),
+                    prepared_format=api.PreparedWeightFormat(
+                        weights=api.WeightEncoding.TRELLIS,
+                        scales=api.ScaleEncoding.TRELLIS_SCALES,
+                        packing=api.WeightPacking.TRELLIS_NATIVE,
+                        available_packings=frozenset(
+                            {api.WeightPacking.TRELLIS_NATIVE}
+                        ),
+                    ),
+                    _impl=plan_impl,
+                ),
+                _impl=prepared,
+            )
+            layer.exl3_prepared_experts = experts
+            plan = api.plan_execution(
+                experts=experts,
+                capacity=api.ExecutionCapacity(
+                    max_tokens=int(workload.max_tokens),
+                    top_k=topk,
+                    warmup_token_counts=counts,
+                    # vLLM supplies final top-k IDs/weights to bind(); the
+                    # router workspace is unused and expert maps are gone
+                    # from this b12x revision.
+                    route_num_experts=0,
+                ),
+                routing=api.RoutingSpec(apply_router_weight_on_input=False),
+                invocation=_load_b12x_preparation().FrozenMapping(
+                    {"tuning_route_pattern": "cyclic_disjoint_topk"}
+                ),
+            )
+            layer.exl3_execution_plan = plan
+            layer.exl3_execution_counts = counts
+        # Session trial calls bind through the canonical wrapper (its identity
+        # with the plan declaration is enforced at bind); the raw adopted
+        # owner never reaches bind.
+        experts = getattr(layer, "exl3_prepared_experts", None)
+        if experts is None:
+            raise RuntimeError(
+                f"{_REVISION_TAG} EXL3 rank-sliced layer {layer.layer_name!r} "
+                "lost its canonical PreparedExperts wrapper"
+            )
+        scratch_key = (
+            int(layer.exl3_hidden_size),
+            int(layer.exl3_intermediate_size_per_partition),
+            int(layer.local_num_experts),
+            topk,
+            int(workload.max_tokens),
+            prepared.w1_fp4.device,
+        )
+        scratch = _UNIFORM_EXECUTION_SCRATCH.get(scratch_key)
+        if scratch is None:
+            scratch = tuple(
+                torch.empty(spec.shape, dtype=spec.dtype, device=spec.device)
+                for spec in plan.scratch_specs()
+            )
+            _UNIFORM_EXECUTION_SCRATCH[scratch_key] = scratch
+        layer.exl3_execution_scratch = scratch
+        from vllm.model_executor.layers.fused_moe.b12x import (
+            _prepared_moe_call_factory,
+        )
+
+        output_dtype = workload.output_dtype
+        if hasattr(plan, "token_counts"):
+            plan_counts = tuple(int(count) for count in plan.token_counts)
+            calls = {
+                count: _prepared_moe_call_factory(
+                    tokens=count,
+                    topk=topk,
+                    prepared=experts,
+                    output_dtype=output_dtype,
+                )
+                for count in plan_counts
+            }
+            benchmark_calls = {
+                count: _prepared_moe_call_factory(
+                    tokens=count,
+                    topk=topk,
+                    prepared=experts,
+                    output_dtype=output_dtype,
+                )
+                for count in plan_counts
+            }
+            request = plan.request(
+                name=f"exl3_rank_sliced:{layer.layer_name}",
+                prepare_calls=calls,
+                benchmark_calls=benchmark_calls,
+            )
+        else:
+            request = plan.request(
+                name=f"exl3_rank_sliced:{layer.layer_name}",
+                prepare_call=_prepared_moe_call_factory(
+                    tokens=counts[0],
+                    topk=topk,
+                    prepared=experts,
+                    output_dtype=output_dtype,
+                ),
+                benchmark_call=_prepared_moe_call_factory(
+                    tokens=counts[0],
+                    topk=topk,
+                    prepared=experts,
+                    output_dtype=output_dtype,
+                ),
+            )
+        bits_values = tuple(getattr(layer, "exl3_layer_bitrates", ()) or (0,))
+        key = (
+            "exl3-w4a16",
+            int(bits_values[0]),
+            int(layer.exl3_hidden_size),
+            int(layer.exl3_intermediate_size_per_partition),
+            int(layer.local_num_experts),
+            topk,
+            counts,
+        )
+        logger.info_once(
+            "%s EXL3 rank-sliced execution plan registered: layer=%s "
+            "counts=%d capacity=%d topk=%d",
+            _REVISION_TAG,
+            layer.layer_name,
+            len(counts),
+            int(workload.max_tokens),
+            topk,
+        )
+        return (
+            B12xPreparationUnit(
+                name="EXL3W4A16",
+                key=key,
+                requests=(request,),
+                stage="weights",
+            ),
+        )

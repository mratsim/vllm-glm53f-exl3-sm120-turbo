+    except Exception as exc:
+        raise RuntimeError(
+            f"{_REVISION_TAG} Rank-sliced EXL3 session planning requires "
+            "b12x.preparation (FrozenMapping lives there, matching vllm's "
+            "own B12xExperts import). Install a matching B12X build."
+        ) from exc
+    _B12X_PREPARATION_API = preparation
+    return preparation

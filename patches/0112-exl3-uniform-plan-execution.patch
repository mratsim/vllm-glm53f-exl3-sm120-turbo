+def _load_b12x_preparation() -> Any:
+    """Resolve the b12x session-preparation API lazily.
+
+    vLLM's own B12xExperts imports FrozenMapping from b12x.preparation
+    (fused_moe/b12x.py), not from b12x.moe.fused_moe - boot 6 proved the
+    plan module has no such attribute (b12x _lib/meta.py PEP 562 raises).
+    """
